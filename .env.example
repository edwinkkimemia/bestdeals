# Copy to .env (never commit real secrets)
# Runtime URL. On Neon use the POOLED connection string (hostname has "-pooler").
DATABASE_URL="postgresql://chap:chap@localhost:5432/chap?schema=public"
# Prisma CLI only (migrate/introspect/push): direct, unpooled connection.
# Neon's Vercel integration sets this automatically as DATABASE_URL_UNPOOLED.
# Local Docker Postgres: same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://chap:chap@localhost:5432/chap?schema=public"
AUTH_SECRET="change-me-to-32-plus-random-characters"
ADMIN_EMAILS="admin@chap.co.ke"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Deploy seed: demo accounts (<name>@demo.chap.co.ke) share this password.
# Public demo credentials — rotate for anything beyond demos.
SEED_USER_PASSWORD="ChapDemo123!"
# Production databases: set to "false" so the seed skips fictional demo
# shops/listings/accounts (categories, plans, blog and admins still seed).
SEED_DEMO_CATALOGUE="true"

# Admin survival across redeploys: every deploy seed promotes these emails to
# ADMIN (existing rows) and auto-creates missing ones with ADMIN_PASSWORD.
# Without a persistent DATABASE_URL the store is in-memory and ANY account
# (admin included) vanishes on restart — set DATABASE_URL first, then these.
# ADMIN_PASSWORD falls back to SEED_USER_PASSWORD if unset; if neither is set,
# missing admins are NOT created (sign up once at /auth/signup instead).
# ADMIN_PASSWORD=""

# Object storage (product images + private seller docs)
# Profile photos, shop logos/covers and listing images MUST live on persistent
# storage in production: local public/uploads is git-ignored and Vercel /tmp is
# wiped on every redeploy/instance recycle, so images "disappear" without this.
# Setting S3_BUCKET + S3_ACCESS_KEY + S3_SECRET_KEY auto-enables S3 (no extra
# flag needed). UPLOAD_DRIVER is optional: "s3" forces S3, "local" forces local.
UPLOAD_DRIVER=""
S3_ENDPOINT=""
S3_BUCKET="chap-media"
S3_REGION="eu-west-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email / SMS / WhatsApp providers (leave empty for console-log demo mode)
# EMAIL_PROVIDER: resend | sendgrid | zeptomail (Zoho ZeptoMail Agent Send Mail Token)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="info@chap.co.ke"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID="Chap"

# M-Pesa Daraja (sandbox first). Integration stays labelled NOT LIVE until set + tested.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://chap.co.ke/api/payments/mpesa-callback"
# Callback authentication: long random string appended as ?key= to the callback
# URL and verified on receipt. REQUIRED in production — without it anyone can
# forge payment confirmations. Generate: openssl rand -hex 32
MPESA_CALLBACK_SECRET=""
# Dispute refunds: Daraja reversal credentials (initiator name + pre-encrypted
# security credential from Safaricom tooling). Without these, refunds are
# ledger-only and staff reverse manually.
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# Card provider (future)
CARD_PROVIDER=""
CARD_PUBLIC_KEY=""
CARD_SECRET_KEY=""

# Optional infra
REDIS_URL=""
SENTRY_DSN=""

# Google AdSense (all empty = no ad code ships anywhere — safe pre-approval).
# 1) Apply with the live domain, wait for approval. 2) Create 3 display units
#    and paste their IDs below. 3) Deploy. Consent banner + checkout/account
#    page exclusions are automatic.
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_FEED=""
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=""
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=""
