# Copy to .env (never commit real secrets)
DATABASE_URL="postgresql://chap:chap@localhost:5432/chap?schema=public"
AUTH_SECRET="change-me-to-32-plus-random-characters"
ADMIN_EMAILS="admin@chap.co.ke"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Deploy seed: demo accounts (<name>@demo.chap.co.ke) share this password.
# Public demo credentials — rotate for anything beyond demos.
SEED_USER_PASSWORD="ChapDemo123!"

# Object storage (product images + private seller docs)
